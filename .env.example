# Nakili faili hii kuwa ".env" kisha jaza thamani zako halisi.
# ".env" haipaswi kuwekwa kwenye git (tazama .gitignore).

# --- Barua pepe (OTP) ---
# Kwa Gmail: tumia "App Password" (sio password ya kawaida ya akaunti),
# inahitaji 2-Step Verification iwe imewashwa kwenye akaunti ya Google:
# https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# --- Site URL (kwa share links) ---
SITE_URL=http://127.0.0.1:8000

# --- Google Sign-In (OAuth "Web application" Client ID) ---
# Pata kutoka https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
